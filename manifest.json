{
  "id": "time-capsule",
  "contexts": ["household", "shared_space"],
  "name": "Time Capsule",
  "version": "1.1.0",
  "description": "Seal family letters, predictions, and photos until a shared reveal date, then open everything together.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": ["memories", "letters", "predictions", "family", "sealed"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "capsules": {"sql": "SELECT * FROM app_time_capsule__capsules ORDER BY reveal_date ASC, created_at ASC"},
    "entries": {"sql": "SELECT * FROM app_time_capsule__entries ORDER BY created_at ASC"},
    "attachments": {"sql": "SELECT * FROM app_time_capsule__attachments ORDER BY created_at ASC"}
  },
  "db_plaintext_columns": ["entry_type"],
  "row_policies": {
    "capsules": {
      "kind": "adult_writable",
      "frozen_when": {
        "status_column": "status",
        "locked_values": ["archived"]
      }
    },
    "entries": {
      "kind": "sealed_until",
      "fk_column": "capsule_id",
      "parent_table": "capsules",
      "writer_column": "member_id",
      "parent_status_column": "status",
      "visible_parent_status_values": ["revealed", "archived"],
      "visible_after_parent_column": "reveal_date",
      "frozen_when": {
        "status_column": "status",
        "locked_values": ["closed", "revealed", "archived"]
      }
    },
    "attachments": {
      "kind": "sealed_until",
      "fk_column": "capsule_id",
      "parent_table": "capsules",
      "writer_column": "uploaded_by",
      "parent_status_column": "status",
      "visible_parent_status_values": ["revealed", "archived"],
      "visible_after_parent_column": "reveal_date",
      "frozen_when": {
        "status_column": "status",
        "locked_values": ["closed", "revealed", "archived"]
      }
    }
  },
  "automation_actions": {
    "create_capsule": {
      "title": "Open a time capsule",
      "description": "Open a capsule pointed at a date another app already knows about — a milestone birthday, a graduation, a move. Only the container is created; every letter inside it is still written by a person.",
      "params": {
        "title": { "type": "text", "label": "Capsule title", "required": true },
        "reveal_date": { "type": "text", "label": "Opens on (yyyy-mm-dd)", "required": true },
        "occasion": { "type": "text", "label": "Occasion", "default": "" },
        "prompt": { "type": "text", "label": "Prompt for writers", "default": "" }
      },
      "dedupe": { "table": "capsules", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "capsules",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "occasion": ":occasion",
            "prompt": ":prompt",
            "reveal_date": ":reveal_date",
            "status": "open",
            "created_by_id": "automation",
            "created_by_name": "Automation",
            "created_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "suggested_automations": [
    {
      "title": "Open a capsule for a milestone on the calendar",
      "description": "A dated milestone opens a capsule that reveals on the day itself, so there is somewhere to put the letters months before anyone would have thought to create it.",
      "trigger_event": "calendar.event_created",
      "target_app_id": "time-capsule",
      "action_id": "create_capsule",
      "param_map": {
        "title": { "kind": "payload_field", "value": "title" },
        "reveal_date": { "kind": "payload_field", "value": "start_date" },
        "prompt": { "kind": "const", "value": "Write something for whoever opens this on the day." }
      }
    }
  ],
  "publishes": [
    "time_capsule.created",
    "time_capsule.closed",
    "time_capsule.revealed"
  ],
  "publish_acls": {
    "time_capsule.created": { "require_role": "adult" },
    "time_capsule.closed": { "require_role": "adult" },
    "time_capsule.revealed": { "require_role": "adult" }
  },
  "alert_on": ["time_capsule.created", "time_capsule.revealed"],
    "member_references": {
      "capsules": {
        "column": "created_by_id",
        "on_removed": "keep"
      },
      "entries": {
        "column": "member_id",
        "on_removed": "keep"
      },
      "attachments": {
        "column": "uploaded_by",
        "on_removed": "keep"
      }
    },
  "nav": { "label": "Capsules" },
  "agenda": {
    "kind": "event",
    "label": "Capsule opens",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, title AS title, NULLIF(occasion, '') AS subtitle, reveal_date AS when_at FROM app_time_capsule__capsules WHERE status <> 'archived' AND reveal_date = :today ORDER BY created_at LIMIT 20"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT title AS title, occasion AS subtitle, reveal_date AS opens_on FROM app_time_capsule__capsules WHERE status IN ('open', 'closed') AND reveal_date >= :today ORDER BY reveal_date LIMIT 3"
    },
    "display": { "template": "list", "title": "title", "subtitle": "subtitle", "when": "opens_on" },
    "ambient_card": "countdown"
  },
  "widget": { "label": "Time Capsule", "size": "small" },
  "resource_limits": {
    "max_db_bytes": 52428800,
    "max_file_bytes": 10485760,
    "max_files_bytes": 524288000
  },
  "icon": "⌛",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["open_capsules"]
  }
}
